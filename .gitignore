# Operating system and editors
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.idea/
.vscode/
*.swp
*.swo

# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Local environments and secrets (keep shareable templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template
.venv/
venv/
env/
.python-version

# Build and distribution artifacts
build/
dist/
*.egg-info/
.eggs/
lib/
lib64/
sdist/
wheels/
*.egg
MANIFEST

# Tool caches, test output, and notebook checkpoints
.cache/
.tox/
.nox/
.coverage
.coverage.*
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
coverage/
htmlcov/

# Runtime files and databases
*.log
*.pem
*.db
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
instance/
celerybeat-schedule
celerybeat.pid
*.manifest
*.spec

# Generated translation files
*.mo
*.pot

# Local data: keep directory placeholders, never champion exports or databases
/data/**
!/data/**/
!/data/**/.gitkeep

# All generated results, including champion exports, statistics, and archives
/results/

# Local models, context data, diagnostics, and JavaScript dependencies
/models/
/contexts/
/diagnostics/
/node_modules/

# Local agent tooling
/.agent/
/.specify/
/.devops/

# Experiment and server logs (keep the root directory placeholder)
/logs/*
!/logs/.gitkeep

# Serialized runtime checkpoints
*.pkl

# Generated PNGs: thesis illustrations are the intentional exception
*.png
!/writing/thesis/images/**/*.png
